# T-Invest Sandbox token only. Never commit the real token.
TINVEST_SANDBOX_TOKEN=

# Static bearer token used by the MCP client. Generate 32+ random characters.
MCP_ACCESS_TOKEN=

# Safe defaults: no trading until explicitly enabled in Vercel secrets.
TRADING_ENABLED=false
KILL_SWITCH=false

# Sandbox controls
AUTO_CREATE_SANDBOX_ACCOUNT=true
SANDBOX_START_RUB=1000000
ALLOWED_INSTRUMENTS=SBER_TQBR,LKOH_TQBR,YDEX_TQBR,GAZP_TQBR
MAX_RISK_PER_TRADE=0.005
MAX_OPEN_POSITIONS=2
MAX_TRADES_PER_DAY=4
MAX_TRADE_NOTIONAL_RUB=250000
MIN_SECONDS_BETWEEN_TRADES=900
MAX_CUMULATIVE_DRAWDOWN_PCT=0.02
